    "preloadExampleJs": "this.load.atlas('bia_throw', 'assets/ilha_farol/asset_11_bia_throw/asset_11_bia_throw.png', 'assets/ilha_farol/asset_11_bia_throw/asset_11_bia_throw.json');\nthis.load.json('config_asset_11', 'assets/ilha_farol/asset_11_bia_throw/asset_11_bia_throw.json');",
    "createExampleJs": "const cfg = this.cache.json.get('config_asset_11');\nfor (const anim of cfg.phaserAnimations.anims) {\n  if (!this.anims.exists(anim.key)) this.anims.create(anim);\n}",
