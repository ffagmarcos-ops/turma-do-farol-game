    "preloadExampleJs": "this.load.atlas('monkey', 'assets/ilha_farol/asset_17_monkey/asset_17_monkey.png', 'assets/ilha_farol/asset_17_monkey/asset_17_monkey.json');\nthis.load.json('config_asset_17', 'assets/ilha_farol/asset_17_monkey/asset_17_monkey.json');",
    "createExampleJs": "const cfg = this.cache.json.get('config_asset_17');\nfor (const anim of cfg.phaserAnimations.anims) {\n  if (!this.anims.exists(anim.key)) this.anims.create(anim);\n}",
    "exampleBasePath": "assets/ilha_farol/",
    "pathRule": "Os exemplos assumem que a pasta ilha_farol está disponível em assets/ilha_farol/. Ajustar apenas esse prefixo à estrutura do projeto.",
