    "preloadExampleJs": "this.load.atlas('water_particles', 'assets/ilha_farol/asset_35_water_particles/asset_35_water_particles.png', 'assets/ilha_farol/asset_35_water_particles/asset_35_water_particles.json');\nthis.load.json('config_asset_35', 'assets/ilha_farol/asset_35_water_particles/asset_35_water_particles.json');",
    "createExampleJs": "const cfg = this.cache.json.get('config_asset_35');\nfor (const anim of cfg.phaserAnimations.anims) {\n  if (!this.anims.exists(anim.key)) this.anims.create(anim);\n}",
    "exampleBasePath": "assets/ilha_farol/",
    "pathRule": "Os exemplos assumem que a pasta ilha_farol está disponível em assets/ilha_farol/. Ajustar apenas esse prefixo à estrutura do projeto.",
