  sourceId: macaco
  requiresPort: 0
  originalJson: "{\n    \"id\": \"macaco\",\n    \"kind\": \"\",\n    \"type\": \"\",\n   
    \"tiles\": \"\",\n    \"text\": \"O macaco levanta o bra\xE7o antes de jogar
    a pedra \u2014 olhe a sombra no ch\xE3o e use {attack}!\",\n    \"event\": \"\",\n   
    \"x\": 16000.0,\n    \"y\": 0.0,\n    \"w\": 0.0,\n    \"h\": 0.0,\n    \"scale\":
    1.0,\n    \"minX\": 0.0,\n    \"maxX\": 0.0,\n    \"toninhoX\": 0.0,\n    \"ropeX\":
    0.0,\n    \"topY\": 0.0,\n    \"bottomY\": 0.0,\n    \"marinaX\": 0.0,\n    \"marinaY\":
    0.0,\n    \"crateStartX\": 0.0,\n    \"crateTargetX\": 0.0,\n    \"crateY\":
