    0.0,\n    \"sniffX\": 0.0,\n    \"period\": 0.0,\n    \"phase\": 0.0,\n    \"amp\":
    0.0,\n    \"moveX\": 0.0,\n    \"moveY\": 0.0,\n    \"speed\": 0.0,\n    \"crateStartY\":
    0.0,\n    \"crateTargetY\": 0.0,\n    \"gold\": false,\n    \"flip\": false,\n   
    \"front\": false,\n    \"crumble\": false,\n    \"slippery\": false,\n    \"sway\":
    false,\n    \"respawn\": {\n        \"x\": 0.0,\n        \"y\": 0.0\n    },\n   
    \"move\": {\n        \"axis\": \"\",\n        \"range\": 0.0,\n        \"period\":
    0.0,\n        \"phase\": 0.0\n    },\n    \"buoys\": [],\n    \"secretPlatforms\":
    []\n}"
  nextStep: "Mec\xE2nica nativa ligada por FarolIslandMechanics, FarolEnemy ou FarolIslandSurface;
    conferir relat\xF3rio da revis\xE3o."
