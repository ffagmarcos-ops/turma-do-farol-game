.btn-menu:focus { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_menu_hover.png"); }
.btn-menu:active { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_menu_pressed.png"); }
