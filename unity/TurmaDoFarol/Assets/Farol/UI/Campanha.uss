.root { flex-grow: 1; color: rgb(255,244,218); font-size: 24px; }
.hidden { display: none; }
.hud { position: absolute; top: 22px; left: 28px; right: 28px; flex-direction: row; justify-content: space-between; align-items: flex-start; }
.hud-box { background-color: rgba(5,25,39,0.93); padding: 16px 24px; border-radius: 14px; max-width: 850px; }
.stage { font-size: 32px; -unity-font-style: bold; }
.small { font-size: 22px; color: rgb(221,230,229); white-space: normal; }
.controls { position: absolute; bottom: 20px; left: 28px; right: 28px; background-color: rgba(5,25,39,0.9); padding: 12px 20px; border-radius: 10px; }
.prompt { position: absolute; bottom: 90px; align-self: center; font-size: 32px; background-color: rgba(5,25,39,0.92); padding: 14px 28px; border-radius: 14px; -unity-text-align: middle-center; white-space: normal; }
Button { color: rgb(255,244,218); background-color: rgb(17,57,68); border-width: 2px; border-color: rgb(99,139,142); border-radius: 10px; font-size: 26px; margin: 7px 0; padding: 16px 30px; min-height: 62px; }
Button:hover { background-color: rgb(38,89,100); border-color: rgb(245,204,112); }
Button:focus { border-color: rgb(245,204,112); }
.primary { background-color: rgb(212,154,65); color: rgb(26,35,36); border-color: rgb(255,224,155); -unity-font-style: bold; }
.overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(3,17,29,0.75); justify-content: center; align-items: center; }
.card { background-color: rgba(5,25,39,0.96); padding: 32px 44px; border-radius: 20px; width: 700px; border-width: 2px; border-color: rgb(111,150,150); }
.title { font-size: 56px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; margin-bottom: 14px; }
.subtitle { font-size: 26px; white-space: normal; -unity-text-align: middle-center; margin-bottom: 24px; }
.hq { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgb(3,16,26); }
.panel-art { position: absolute; top: 12px; left: 18px; right: 18px; bottom: 12px; -unity-background-scale-mode: scale-to-fit; }
.dialogue { position: absolute; top: 24px; left: 100px; right: 100px; background-color: rgba(5,25,39,0.94); padding: 22px 32px; border-radius: 14px; }
.speaker { font-size: 30px; -unity-font-style: bold; color: rgb(255,215,133); }
.speech { font-size: 29px; white-space: normal; }
.dialogue-actions { position: absolute; bottom: 30px; left: 100px; right: 100px; flex-direction: row; justify-content: flex-end; }
.dialogue-actions Button { margin-left: 18px; }
ProgressBar { height: 30px; margin-top: 8px; }
.unity-progress-bar__background { background-color: rgb(25,49,60); border-radius: 8px; }
.unity-progress-bar__progress { background-color: rgb(224,177,78); border-radius: 8px; }
.notice { font-size: 25px; white-space: normal; margin: 16px 0; }

.portal-hall { width: 1700px; max-width: 96%; height: 94%; background-color: rgba(8,28,45,0.94); padding: 24px; border-radius: 18px; }
.portal-scroll { flex-grow: 1; }
.portal-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.portal-card { width: 295px; height: 240px; margin: 9px; padding: 9px; background-color: rgba(36,69,80,0.95); border-radius: 12px; }
.portal-thumbnail { height: 125px; width: 260px; }
.portal-card Label { font-size: 19px; white-space: normal; color: rgb(255,242,212); }
.portal-card Button { font-size: 18px; min-height: 35px; margin-top: 4px; }
.extra-images { position: absolute; bottom: 130px; left: 10%; right: 10%; flex-direction: row; justify-content: center; flex-wrap: wrap; }
.extra-images Button { min-width: 140px; font-size: 20px; }

.art-expanded { scale: 1.25 1.25; }
.lens-0 { rotate: 0deg; }
.lens-1 { rotate: 45deg; }
.lens-2 { rotate: 90deg; }
.lens-3 { rotate: 135deg; }
.lens-4 { rotate: 180deg; }
.lens-5 { rotate: 225deg; }
.lens-6 { rotate: 270deg; }
.lens-7 { rotate: 315deg; }

.hq-backdrop, .hq-frame { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.hq-window { position: absolute; left: 11.71875%; right: 11.19792%; top: 14.35185%; bottom: 14.35185%; overflow: hidden; }
.hq-window > .panel-art { top: 0; left: 0; right: 0; bottom: 0; }
.art-button { background-color: rgba(0,0,0,0); border-width: 0; border-radius: 0; color: rgb(255,243,214); -unity-font-style: bold; -unity-text-align: middle-center; -unity-slice-left: 144; -unity-slice-right: 67; -unity-slice-top: 0; -unity-slice-bottom: 0; -unity-slice-scale: 0.8; padding-left: 125px; padding-right: 60px; min-height: 70px; flex-shrink: 0; }
.art-button:hover, .art-button:focus, .art-button:active { background-color: rgba(0,0,0,0); border-width: 0; }
.art-button:disabled { opacity: 0.45; }
#bossTest { font-size: 22px; }
.dialogue-actions .art-button { font-size: 23px; }
.card { max-height: 94%; }
.credits-card { width: 1200px; height: 920px; }
.credits-scroll { flex-grow: 1; }
.credits-author { font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; margin-top: 18px; }
.credits-work { font-size: 24px; -unity-text-align: middle-center; white-space: normal; margin: 8px 14px 18px 14px; }
