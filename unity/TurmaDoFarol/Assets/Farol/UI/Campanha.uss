.btn-jogar:hover { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_jogar_hover.png"); }
.btn-jogar:focus { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_jogar_hover.png"); }
.btn-jogar:active { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_jogar_pressed.png"); }
.btn-continuar { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_continuar_normal.png"); }
.btn-continuar:hover { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_continuar_hover.png"); }
.btn-continuar:focus { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_continuar_hover.png"); }
.btn-continuar:active { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_continuar_pressed.png"); }
.btn-portais { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_portais_normal.png"); }
.btn-portais:hover { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_portais_hover.png"); }
.btn-portais:focus { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_portais_hover.png"); }
.btn-portais:active { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_portais_pressed.png"); }
.btn-jogar_de_novo { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_jogar_de_novo_normal.png"); }
.btn-jogar_de_novo:hover { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_jogar_de_novo_hover.png"); }
.btn-jogar_de_novo:focus { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_jogar_de_novo_hover.png"); }
.btn-jogar_de_novo:active { background-image: url("../../Originais/farol/fase3/ui/botoes/btn_jogar_de_novo_pressed.png"); }
